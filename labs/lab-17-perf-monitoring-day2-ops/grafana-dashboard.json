{
  "__comment": "lab-17 GPU fleet health dashboard. Portable Grafana model (schemaVersion 39). PromQL over the GKE-managed dcgm-exporter series scraped by Google Managed Prometheus; every series is keyed by the real labels gpu + Hostname (see assets/lab-17/baseline_promql.txt). Import: Grafana -> Dashboards -> Import -> paste; pick a Prometheus/GMP datasource for the $ds variable. The 'SM clock vs engine-active' panel is the silent-throttle correlate lab-17 Phase C induces.",
  "title": "GPU Fleet Health (DCGM) — lab-17",
  "uid": "gpu-fleet-health-lab17",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "30s",
  "tags": ["gpu", "dcgm", "day-2"],
  "templating": {
    "list": [
      {
        "name": "ds",
        "type": "datasource",
        "query": "prometheus",
        "label": "Datasource",
        "current": {}
      },
      {
        "name": "node",
        "type": "query",
        "datasource": "${ds}",
        "label": "Node",
        "includeAll": true,
        "multi": true,
        "refresh": 2,
        "query": "label_values(DCGM_FI_DEV_SM_CLOCK, Hostname)"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "SM clock (MHz) — collapse under load = throttle",
      "type": "timeseries",
      "datasource": "${ds}",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "rothz", "custom": { "drawStyle": "line" } } },
      "targets": [
        {
          "expr": "DCGM_FI_DEV_SM_CLOCK{Hostname=~\"$node\"}",
          "legendFormat": "{{Hostname}} gpu{{gpu}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Power draw (W) — pinned at the cap = power-limited",
      "type": "timeseries",
      "datasource": "${ds}",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "watt" } },
      "targets": [
        {
          "expr": "DCGM_FI_DEV_POWER_USAGE{Hostname=~\"$node\"}",
          "legendFormat": "{{Hostname}} gpu{{gpu}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Silent-throttle correlate: engine-active (%) vs SM clock",
      "description": "When engine-active stays high but SM clock drops, the GPU is throttling under real load — the GPUSilentThrottle alert. Both series overlaid per GPU.",
      "type": "timeseries",
      "datasource": "${ds}",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "percentunit" } },
      "targets": [
        {
          "expr": "DCGM_FI_PROF_GR_ENGINE_ACTIVE{Hostname=~\"$node\"}",
          "legendFormat": "engine {{Hostname}} gpu{{gpu}}",
          "refId": "A"
        },
        {
          "expr": "DCGM_FI_DEV_SM_CLOCK{Hostname=~\"$node\"} / 1980",
          "legendFormat": "clock/max {{Hostname}} gpu{{gpu}}",
          "refId": "B"
        }
      ]
    },
    {
      "id": 4,
      "title": "Tensor pipe active (%) — training utilization",
      "type": "timeseries",
      "datasource": "${ds}",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "percentunit" } },
      "targets": [
        {
          "expr": "DCGM_FI_PROF_PIPE_TENSOR_ACTIVE{Hostname=~\"$node\"}",
          "legendFormat": "{{Hostname}} gpu{{gpu}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Interconnect throughput (bytes/s): NVLink + PCIe",
      "type": "timeseries",
      "datasource": "${ds}",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "Bps" } },
      "targets": [
        {
          "expr": "rate(DCGM_FI_PROF_NVLINK_TX_BYTES{Hostname=~\"$node\"}[1m])",
          "legendFormat": "nvlink-tx {{Hostname}} gpu{{gpu}}",
          "refId": "A"
        },
        {
          "expr": "rate(DCGM_FI_PROF_PCIE_TX_BYTES{Hostname=~\"$node\"}[1m])",
          "legendFormat": "pcie-tx {{Hostname}} gpu{{gpu}}",
          "refId": "B"
        }
      ]
    },
    {
      "id": 6,
      "title": "Framebuffer used (%) — OOM headroom",
      "type": "timeseries",
      "datasource": "${ds}",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "percent", "max": 100 } },
      "targets": [
        {
          "expr": "100 * DCGM_FI_DEV_FB_USED{Hostname=~\"$node\"} / DCGM_FI_DEV_FB_TOTAL{Hostname=~\"$node\"}",
          "legendFormat": "{{Hostname}} gpu{{gpu}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "GPU temperature (C)",
      "type": "timeseries",
      "datasource": "${ds}",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "celsius" } },
      "targets": [
        {
          "expr": "DCGM_FI_DEV_GPU_TEMP{Hostname=~\"$node\"}",
          "legendFormat": "{{Hostname}} gpu{{gpu}}",
          "refId": "A"
        }
      ]
    }
  ]
}
